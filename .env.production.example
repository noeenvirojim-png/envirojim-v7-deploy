# Copy this file to .env.production on the server.
# Never commit .env.production.

APP_DOMAIN=app.example.com

# Supabase project values
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
POSTGRES_URL=replace_with_direct_postgres_connection_string

# AI
GEMINI_API_KEY=replace_with_gemini_api_key
GOOGLE_AI_API_KEY=replace_with_same_gemini_api_key

# Application
NEXT_PUBLIC_SITE_URL=https://app.example.com
NODE_ENV=production

# Optional email
RESEND_API_KEY=
