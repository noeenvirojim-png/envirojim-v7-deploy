# ENVIROJIM - LOCAL ENVIRONMENT TEMPLATE
# Copy this file to .env.local for development

# SUPABASE LOCAL (Default ports after 'npx supabase start')
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_local_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_local_service_role_key_here

# DATABASE (Direct access for scripts)
# Default password is 'postgres' for local Supabase
POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# AI (GEMINI)
# Required for PDF analysis and technical chat
GEMINI_API_KEY=AIzaSyBNoYS_M4FUIsiKH3mZyZ9sfv_PsnGoY6I

# APP SETTINGS
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OPTIONAL: RESEND (Emails)
